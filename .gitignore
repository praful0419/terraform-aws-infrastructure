# Terraform local files
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files (may contain sensitive values)
*.tfvars
*.tfvars.json

# Allow example variable files
!*.tfvars.example

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# AWS credentials and private keys
.aws/
*.pem
*.key

# Environment files
.env
.env.*

# OS generated files
.DS_Store
Thumbs.db
